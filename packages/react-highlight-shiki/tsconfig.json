{
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2025", "DOM"],
    "types": ["node", "hast"],
    "module": "esnext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
