  "description": "Shiki for React",
  "license": "MIT",
  "author": "ryanTheLion200",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanTheLion200/react-highlight-shiki.git",
    "directory": "packages/react-highlight-shiki"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts",
