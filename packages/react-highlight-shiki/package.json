      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dist/hooks": {
      "import": {
        "types": "./dist/hooks/index.d.ts",
        "default": "./dist/hooks/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./hooks": {
        "import": {
          "types": "./dist/hooks/index.d.ts",
          "default": "./dist/hooks/index.js"
        }
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown --minify"
  },
  "dependencies": {
    "es-toolkit": "^1.53.2",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "shiki": "catalog:"
