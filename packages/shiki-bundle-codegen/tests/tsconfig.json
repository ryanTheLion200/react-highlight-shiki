{
  "compilerOptions": {
    "target": "es2025",
    "lib": ["ES2025"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["."],
  "exclude": ["__snapshots__"]
}
