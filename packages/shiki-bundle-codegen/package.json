{
  "name": "shiki-bundle-codegen",
  "version": "0.1.0",
  "description": "Codegen for fine-grained Shiki bundles.",
  "license": "MIT",
  "author": "ryanTheLion200",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanTheLion200/react-highlight-shiki.git",
    "directory": "packages/shiki-bundle-codegen"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown --minify"
  },
  "dependencies": {
    "shiki": "catalog:"
  },
  "devDependencies": {
    "tsdown": "^0.23.4",
    "typescript": "catalog:ts6"
  }
}
